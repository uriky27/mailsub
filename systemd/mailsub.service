[Unit]
Description=mailsub encrypted file sender
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mailsub
Environment=PATH=/opt/mailsub/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=MAILSUB_FILE_URL=https://f3f96efe.withblancvpn.online/s/eb900692a6ce4e8086334f9bd1907831
Environment=MAILSUB_RECIPIENT_EMAIL=uriky27@mail.ru
Environment=MAILSUB_BODY=Please find the encrypted file attached.
ExecStart=/bin/bash -lc 'DATE="$(date +%%Y-%%m-%%d-%%H-%%M)"; exec /opt/mailsub/venv/bin/python /opt/mailsub/server.py "$MAILSUB_FILE_URL" "$MAILSUB_RECIPIENT_EMAIL" "$DATE" "$MAILSUB_BODY"'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
