# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# RSA keys in PEM format
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Email configuration
SENDER_EMAIL=your_email@gmail.com
RECIPIENT_EMAIL=recipient@example.com

# Router-side Mail.ru receiver
MAILRU_EMAIL=router@mail.ru
MAILRU_PASSWORD=your_mailru_password_or_app_password
MAILRU_IMAP_HOST=imap.mail.ru
MAILRU_IMAP_PORT=993
MAILRU_MAILBOX=INBOX
ROUTER_OUTPUT_DIR=/data/mailsub
